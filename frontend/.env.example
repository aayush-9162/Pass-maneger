# ---------------------------------------------------------------------------
# PassM web console
#
# Copy to `.env.local`. Anything prefixed VITE_ is embedded in the client bundle
# and is therefore public - never put a secret here.
# ---------------------------------------------------------------------------

# Base URL of the PassM API, including the version prefix.
#
# Usually leave it unset. Defaults: `npm run dev` calls http://localhost:4000/api/v1,
# and `npm run build` calls /api/v1 on the same server that serves the console
# (WEB_ROOT) - which needs no rebuild if the server's IP address ever changes.
# VITE_API_URL=http://localhost:4000/api/v1

# Path a production build is served under (the backend's WEB_BASE_PATH must
# match). Default: passmadmin -> http://<host>:<port>/passmadmin/
# VITE_BASE_PATH=passmadmin

# Shown in the header; useful for distinguishing staging from production.
VITE_APP_NAME=PassM
VITE_ENVIRONMENT_LABEL=
