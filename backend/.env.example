###############################################################################
# PassM - Backend environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Generate cryptographically strong secrets with: npm run generate:secrets
#
# NEVER commit a populated .env file.
###############################################################################

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_NAME=PassM
PORT=4000
# 0.0.0.0 binds every interface, which is what makes the server reachable from
# other machines on the LAN. Use 127.0.0.1 to restrict it to this machine.
HOST=0.0.0.0
# Number of reverse proxies in front of the app (0 = direct exposure).
# Must be > 0 behind nginx/ALB or client IPs and rate limiting will be wrong.
TRUST_PROXY_HOPS=0

# --- Logging -----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# --- MySQL -------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=passm_app
DB_PASSWORD=change_me
DB_NAME=passm
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
# Enable TLS to MySQL in production. Point DB_SSL_CA at the CA bundle.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Redis (optional session/rate-limit cache) -------------------------------
# When false the app transparently falls back to an in-process cache.
# Multi-instance / PM2 cluster deployments SHOULD enable Redis.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=passm:

# --- JWT ---------------------------------------------------------------------
# Each secret must be >= 32 characters and all three must differ.
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_value_for_access_tokens_0000000
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_value_for_refresh_tokens_000000
JWT_DEVICE_TRUST_SECRET=replace_with_64_char_random_hex_for_device_trust_00000000000
JWT_ISSUER=passm.internal
JWT_AUDIENCE=passm.clients
# Short-lived access token. Keep it small; refresh is cheap and automatic.
ACCESS_TOKEN_TTL=15m
# How long a sign-in lasts. Expiry slides on every rotation, so a device in
# daily use never reaches it.
REFRESH_TOKEN_TTL=180d
DEVICE_TRUST_TTL=180d

# --- Encryption at rest (AES-256-GCM) ----------------------------------------
# 32 random bytes, base64 encoded. Rotate by moving the old value to
# ENCRYPTION_KEY_PREVIOUS (decrypt-only) and setting a new ENCRYPTION_KEY.
#
# This key encrypts every stored password: together with a database copy it
# decrypts all of them. Keep it in a secret manager, out of backups, and never
# lose it - without it no stored password can be read again.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY_PREVIOUS=
ENCRYPTION_KEY_PREVIOUS_ID=k0

# --- Session & lockout policy ------------------------------------------------
#
# These are now *defaults*, not the live policy. An administrator changes them at
# runtime from Admin > Security policy, and the stored value wins. What is set
# here applies to a fresh database and to any setting nobody has touched, so an
# existing deployment keeps the policy it was configured with after upgrading.
# 180 days, matching REFRESH_TOKEN_TTL - otherwise the shorter of the two decides
# how long a sign-in lasts and changing only one has no visible effect.
SESSION_IDLE_TIMEOUT_MINUTES=259200
MAX_ACTIVE_SESSIONS_PER_USER=10
MAX_DEVICES_PER_USER=10

# --- Pinned security settings ------------------------------------------------
#
# Comma-separated setting keys that the admin panel may NOT change. Pinned keys
# always take their value from this file, and the API refuses writes to them.
#
# This is the floor a compromised administrator account cannot lower. If you rely
# on a control being on - CSRF, a minimum password length, the IP allow list
# staying enforced - pin it here and it survives an attacker with admin rights.
#
# Key names are exactly those in `SECURITY_SETTING_DEFINITIONS` (@passm/shared).
# An unknown name is logged as an error at boot rather than silently ignored.
#
# Example:
#   SECURITY_SETTINGS_LOCK=csrfEnabled,passwordMinLength,emergencyLockActive
SECURITY_SETTINGS_LOCK=

# --- Web console -------------------------------------------------------------
# Serve the console from this process, giving one origin and one port.
# Recommended for LAN deployments: no CORS surface, and cookies need only
# SameSite=Lax. Build it first with `npm run build:web` from the repo root.
#   WEB_ROOT=../frontend/out
# Leave empty to run the console separately (`npm run dev:frontend` on port 3000).
WEB_ROOT=

# --- Google sign-in ----------------------------------------------------------
# The only way to sign in. Create an OAuth 2.0 "Web application" client in
# Google Cloud Console (APIs & Services -> Credentials) and add:
#   Authorized JavaScript origins: every address the console is opened at,
#     e.g. http://localhost:3000 and https://passm.123cfc.com
#     (Google refuses bare IP addresses - use a hostname, even an internal one)
#   Authorized redirect URIs: the extension's address,
#     https://fllkfipajdahciclfcimfcenmfallgfm.chromiumapp.org/
# The client id is not a secret; there is no client secret to configure.
GOOGLE_CLIENT_ID=
# Workspace domains whose accounts may sign in. Anyone from these domains gets
# an account on first sign-in (as a Member). Required in production.
GOOGLE_ALLOWED_DOMAINS=123cfc.com

# --- CORS / cookies ----------------------------------------------------------
# Comma separated exact origins. Wildcards are rejected when credentials are on.
# Not needed at all when WEB_ROOT is set - the console is then same-origin.
CORS_ORIGINS=http://localhost:3000
# Allow the packed Chrome extension to call the API (chrome-extension://<id>).
CORS_ALLOW_EXTENSION_ORIGINS=
COOKIE_DOMAIN=
# Forced to true in production, unless ALLOW_INSECURE_HTTP=true and TLS is off
# (a Secure cookie is never sent over http://, so forcing it would break login).
COOKIE_SECURE=false
# lax | strict | none  ("none" requires COOKIE_SECURE=true, and therefore HTTPS).
# Same-origin deployments should stay on "lax".
COOKIE_SAMESITE=lax

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MINUTES=15
REFRESH_RATE_LIMIT_MAX=60
# Provisioning and other sensitive admin operations. Deliberately tight.
SENSITIVE_RATE_LIMIT_MAX=20

# --- HTTP / HTTPS ------------------------------------------------------------
# Item notes are the largest bodies accepted. Per-field limits in the shared
# vault DTOs do the precise capping.
BODY_LIMIT=512kb
# Terminate TLS in-process (single-node and LAN installs). Behind a load
# balancer that already terminates TLS, leave this false and set
# TRUST_PROXY_HOPS instead.
#
# For a LAN deployment reached by IP, generate a certificate with:
#   ./scripts/generate-lan-cert.sh 192.168.68.11
# then set:
#   HTTPS_ENABLED=true
#   TLS_CERT_PATH=certs/server.crt
#   TLS_KEY_PATH=certs/server.key
HTTPS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CA_PATH=
# HSTS max-age in seconds (2 years). Only sent over HTTPS, and a no-op for a
# bare IP address (RFC 6797 applies HSTS to domain names only).
HSTS_MAX_AGE=63072000
SHUTDOWN_TIMEOUT_MS=15000

# Permit plaintext HTTP in production, for a trusted private network.
#
# Passwords and tokens then cross the LAN unencrypted - anyone who can observe
# the network segment can capture them. Only honoured when every configured
# origin is a private address (loopback, 10/8, 172.16/12, 192.168/16, ...).
# Also disables Secure cookies and the HTTPS redirect, since both would
# otherwise make sign-in impossible over HTTP.
ALLOW_INSECURE_HTTP=false

# --- Bootstrap admin (used by `npm run db:seed` only) ------------------------
# The Google account that becomes the first administrator. There is no password.
SEED_ADMIN_EMAIL=you@123cfc.com
SEED_ADMIN_FIRST_NAME=Platform
SEED_ADMIN_LAST_NAME=Administrator
