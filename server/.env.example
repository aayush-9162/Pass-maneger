# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=passvault

# ── JWT ─────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── CORS (production only) ─────────────────────────────────
FRONTEND_URL=https://your-production-domain.com
