# ---------------------------------------------------------------------------
# PassM browser extension
#
# Copy to `.env` before building. These values are compiled into the bundle, so
# nothing secret belongs here.
# ---------------------------------------------------------------------------

# PassM API base URL, including the version prefix. The build also sets the
# manifest's `host_permissions` to this origin, so nothing else needs editing.
#
# On the office network, use the nip.io name of the server (Google sign-in does
# not accept a bare IP):
#   VITE_API_URL=http://192.168.0.211.nip.io:1225/api/v1
VITE_API_URL=http://localhost:4000/api/v1
